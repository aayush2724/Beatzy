# ---- Required ----------------------------------------------------------------
# Local development
VITE_API_URL=http://localhost:3000
# Production (Vercel → Project → Settings → Environment Variables)
# VITE_API_URL=https://beatzy-tvrl.onrender.com

# ---- Site identity (used for canonical URLs, Open Graph, sitemap, legal pages) -
# The public origin of THIS frontend, no trailing slash. Falls back to
# https://beatzy.app, which is a placeholder — set it to the real domain.
VITE_SITE_URL=http://localhost:5173
# Mailboxes shown on the legal pages and in the footer. Defaults are placeholders.
VITE_CONTACT_EMAIL=
VITE_PRIVACY_EMAIL=
# Legal name of the operator shown in the terms and privacy policy.
VITE_LEGAL_ENTITY=

# ---- Optional integrations (nothing loads unless set) -------------------------
# Plausible Analytics site domain, e.g. beatzy.app. Cookieless; disclosed in /privacy.
VITE_PLAUSIBLE_DOMAIN=
# Sentry DSN for frontend error reports. Disclosed in /privacy when set.
VITE_SENTRY_DSN=
# Emit hidden source maps (for a Sentry upload). Off by default.
VITE_SOURCEMAP=false

# Google sign-in is initiated by the backend; this id is only kept for reference.
VITE_GOOGLE_CLIENT_ID=your_google_client_id
